    "# 00 — Data inspection\n",
    "\n",
    "Use this notebook to quickly validate the manifest and preview sample images."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from src.data.loader import SimpleDataset\n",
    "from matplotlib import pyplot as plt\n",
    "\n",
    "# Load sample manifest and show first image\n",
    "ds = SimpleDataset('data/manifest_samples.json', root='.')\n",
    "print('Number of samples:', len(ds))\n",
    "item = ds[0]\n",
    "img = item['image']\n",
    "plt.figure(figsize=(3,6))\n",
    "plt.imshow(img)\n",
    "plt.axis('off')\n"
   ]
  }
